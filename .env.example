# ---- Runtime ----
NODE_ENV=development
PORT=5000
# Number of trusted reverse-proxy hops (set to 1 on Render/Railway/Heroku style hosts)
TRUST_PROXY=0
# On Vercel set TRUST_PROXY=1 and CLIENT_URL to the deployed client origin(s).

# ---- Client / CORS ----
# Comma-separated allowlist. The first entry is used for Stripe redirect URLs.
CLIENT_URL=http://localhost:3000

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=mentorlagbe

# ---- Better Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# ---- JWT (access tokens for protected /api/v1 routes) ----
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ---- Stripe (test mode keys for development) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ---- ImgBB ----
IMGBB_API_KEY=

# ---- Scripts (local development only) ----
SEED_DEMO_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=MentorLagbe Admin
